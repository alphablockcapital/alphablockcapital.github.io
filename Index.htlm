<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alpha Block Capital | Nexus</title>
    <style>
        body {
            background-color: #0a0a0a;
            color: #00d4ff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            text-align: center;
        }
        header {
            padding: 40px;
            background: linear-gradient(180deg, #111, #0a0a0a);
            border-bottom: 2px solid #00d4ff;
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
        }
        h1 { font-size: 3rem; margin: 0; letter-spacing: 5px; color: #fff; }
        .label-status { color: #888; font-size: 0.9rem; margin-top: 10px; }

        /* Section Crypto Live */
        .crypto-container {
            padding: 20px;
            background: #111;
            margin: 20px auto;
            max-width: 900px;
            border-radius: 10px;
            border: 1px solid #333;
        }

        /* Section Jeu */
        .game-section {
            margin-top: 50px;
            padding: 40px;
            background: #000;
            border-top: 1px dashed #444;
        }
        .game-placeholder {
            width: 100%;
            max-width: 800px;
            height: 450px;
            background: #1a1a1a;
            margin: 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #00d4ff;
            border-radius: 15px;
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.1);
        }
    </style>
</head>
<body>

    <header>
        <h1>ALPHA BLOCK CAPITAL</h1>
        <div class="label-status">QUATRE50 LABEL PARTNER | GLOBAL NEXUS</div>
    </header>

    <div class="crypto-container">
        <h3>📊 MARCHÉ CRYPTO EN DIRECT</h3>
        <div class="tradingview-widget-container">
            <script type="text/javascript" src="https://s3.tradingview.com/external-embedding/embed-widget-ticker-tape.js" async>
            {
            "symbols": [
                { "proName": "BINANCE:BTCUSDT", "title": "Bitcoin" },
                { "proName": "BINANCE:ETHUSDT", "title": "Ethereum" },
                { "proName": "BINANCE:SOLUSDT", "title": "Solana" }
            ],
            "showSymbolLogo": true,
            "colorTheme": "dark",
            "isTransparent": true,
            "displayMode": "adaptive",
            "locale": "fr"
            }
            </script>
        </div>
    </div>

    <section class="game-section">
        <h2>🎮 ZONE DE JEU - ALPHA ZERO</h2>
        <div class="game-placeholder">
            <p>[ CHARGEMENT DU MOTEUR DE JEU... ]</p>
            </div>
    </section>

    <footer>
        <p>© 2026 Alpha Block Capital - Propriété de Jean JLK</p>
    </footer>

</body>
</html>
